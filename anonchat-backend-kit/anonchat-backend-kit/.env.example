NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anonchat
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-bytes
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
COOKIE_SECURE=false
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_SECRET=long-random-shared-secret
OTP_TTL_MIN=10
OTP_PEPPER=long-random-string
SUPER_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
ADMIN_CAN_SEE_FULL_NAME=false
STRICT_FIRST_CONTACT=false

